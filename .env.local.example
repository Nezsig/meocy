# ====================================
# MEOCY Photography Studio
# Environment Configuration (Local Development)
# ====================================
#
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control!
#

# ====================================
# Frontend Configuration (Next.js)
# ====================================

# API endpoint for the booking form
# Use http://localhost:4000 for local development
# Use https://api.meocy.com for production
NEXT_PUBLIC_API_URL=http://localhost:4000

# ====================================
# Backend Configuration (Express)
# ====================================

# Server port (default: 4000)
PORT=4000

# Node environment
NODE_ENV=development

# Frontend URL (used for CORS validation)
FRONTEND_URL=http://localhost:3000

# ====================================
# Database Configuration (Supabase)
# ====================================

# Supabase project URL
# Get from: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous API key
# Get from: https://app.supabase.com → Settings → API
# Use the "anon" key, NOT the service_role key
SUPABASE_ANON_KEY=your-anon-key-here

# ====================================
# Email Configuration (Resend)
# ====================================

# Resend API key for sending emails
# Get from: https://resend.com → API Keys
# Keep this secret! Use a strong key.
RESEND_API_KEY=your-resend-api-key-here

# Admin email to receive booking notifications
# Emails will be sent from: noreply@meocy.com
# To: the email specified below
ADMIN_EMAIL=hello@meocy.com

# ====================================
# Optional Settings
# ====================================

# Enable debug logging
DEBUG=false

# ====================================
# Notes
# ====================================
#
# For local development:
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in your Supabase credentials
# 3. Fill in your Resend API key
# 4. Keep .env.local out of git (it's in .gitignore)
#
# For production (Vercel & Railway):
# - Set these as environment variables in deployment dashboard
# - Frontend: https://vercel.com/docs/concepts/projects/environment-variables
# - Backend: https://docs.railway.app/guides/variables
#
# Getting Credentials:
# 1. Supabase: https://supabase.com → Create new project
# 2. Resend: https://resend.com → Sign up and create API key
# 3. Make sure to verify your email domain in Resend for production
#
